{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "rootDir": "src",
    "incremental": true,
    "tsBuildInfoFile": "./.tsbuildinfo.build"
  },
  "include": ["src"],
  "exclude": ["src/test", "**/*.test.ts", "**/*.test.tsx"]
}
