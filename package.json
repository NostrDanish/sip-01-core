{
  "name": "sip-01-core",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable SIP-01 (kind 39697) reference implementation and search-engine core library",
  "type": "module",
  "main": "./dist/sip-01-core.js",
  "module": "./dist/sip-01-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/sip-01-core.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "tsc --noEmit && eslint --cache && vitest run --reporter=dot --silent && vite build && echo 'All tests passed!'"
  },
  "peerDependencies": {
    "@nostrify/nostrify": "^0.52.2",
    "@tanstack/react-query": "^5.100.5",
    "nostr-tools": "^2.23.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nostrify/nostrify": "^0.52.2",
    "@tanstack/react-query": "^5.100.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.0",
    "nostr-tools": "^2.23.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
