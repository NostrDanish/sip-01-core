# ═══════════════════════════════════════════════════════════════════
# SIP-01-core / Dsearch — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# The app runs with NO environment variables at all: every variable below
# is optional. Two disjoint surfaces:
#
#   1. FRONTEND (Vite build-time, VITE_*) — baked into the public bundle.
#      Never put secrets here; anything VITE_* is shipped to every browser.
#   2. WORKER (Cloudflare, worker.ts) — the ONLY place secrets exist.
#      Set with `wrangler secret put` (secrets) or in wrangler.jsonc
#      (non-secret vars). Worker variables must NEVER ship client-side:
#      no VITE_ prefix, no import from frontend code.
#
# ─── 1. Frontend (non-secret, build-time) ───────────────────────────
# Base URL of the engine-AI proxy. Default: same-origin `/api/ai` —
# correct when the worker serves the static app (wrangler deploy with
# assets) or the host rewrites /api/* to the worker. Static hosts whose
# rewrites cannot forward POST bodies can point at the worker directly:
# VITE_ENGINE_API_BASE=https://dsearch.workers.dev/api/ai

# ─── 2. Worker (server-side ONLY — never exposed to the browser) ────
# Secrets — set via `wrangler secret put <NAME>`, never committed:
#   OPENAI_API_KEY        Engine-provided AI key (OpenAI-compatible).
#   AI_API_KEY            Legacy alias for OPENAI_API_KEY (deprecated;
#                         accepted so existing deployments keep working).
#   BRAVE_API_KEY         Brave Search subscription token for the
#                         engine-provided Brave provider (/api/search/brave).
#
# Non-secret vars — set under "vars" in wrangler.jsonc:
#   AI_PROVIDER_ENDPOINT  Default: the engine profile's endpoint
#                         (Dsearch: https://api.ppq.ai/v1).
#   AI_MODEL              Default: the engine profile's model ('auto').
#   AI_PROVIDER_NAME      Display name of the engine-tier provider.
#   AI_ENGINE_ENABLED     'false' disables the engine AI tier operator-side
#                         (any other value, including unset, means enabled).
#   OWNER_PUBKEY          Hex pubkey allowed to administer engine AI from
#                         Admin → AI. Public by design — NOT a secret.
#
# KV binding (optional) — enables admin-UI-managed engine AI config
# (write the key from the Admin tab instead of env vars):
#   AI_CONFIG_KV          Create with `wrangler kv namespace create
#                         AI_CONFIG_KV` and bind it in wrangler.jsonc.

# ═══════════════════════════════════════════════════════════════════
# LEGACY — backend/ self-hosted stack only (0xSearchstr-era)
# ═══════════════════════════════════════════════════════════════════
# Everything below is used exclusively by the optional legacy stack in
# backend/ (Meilisearch + crawlers + NIP-50 relay proxy + abuse API,
# `docker compose up -d`). The frontend and the Cloudflare worker do
# NOT read any of it. Copy to .env only if you run that stack.

# ─── Shared crawler identity (used by every backend crawler) ───
CRAWLER_USER_AGENT=DSearch/0.1 (+https://github.com/NostrDanish/Dsearch)

# ─── Meilisearch ───
MEILI_HOST=http://meilisearch:7700
MEILI_API_KEY=your-meilisearch-master-key-change-this
MEILI_INDEX=dsearch

# ─── Nostr Crawler ───
# Comma-separated list of relay URLs. Default list is used if empty.
NOSTR_RELAYS=wss://relay.damus.io,wss://relay.primal.net,wss://nos.lol,wss://relay.nostr.band,wss://relay.ditto.pub
NOSTR_BATCH_SIZE=50
NOSTR_FLUSH_INTERVAL=5000

# ─── Clearnet Crawler ───
CLEARNET_CONCURRENCY=5
CLEARNET_RATE_LIMIT_MS=2000
CLEARNET_MAX_PAGES_PER_DOMAIN=1000
CLEARNET_MAX_CONTENT_LENGTH=5242880
CLEARNET_BATCH_SIZE=25
CLEARNET_SEED_FILE=./config/seeds-clearnet.txt

# ─── Tor / I2P Crawler ───
TOR_SOCKS_PROXY=socks5h://tor-proxy:9050
I2P_HTTP_PROXY=http://i2pd:4444
TOR_CONCURRENCY=3
TOR_RATE_LIMIT_MS=5000
TOR_BATCH_SIZE=10
TOR_MAX_CONTENT_LENGTH=2097152
TOR_SEED_FILE=./config/seeds-onion.txt
I2P_SEED_FILE=./config/seeds-i2p.txt
BLOCKLIST_REFRESH_INTERVAL=3600000

# ─── Content Policy ───
DOMAIN_BLOCKLIST_PATH=./config/blocklists/domains.txt
HASH_BLOCKLIST_PATH=./config/blocklists/hashes.txt
KEYWORD_BLOCKLIST_PATH=./config/blocklists/keywords.json

# ─── NIP-50 Relay ───
NIP50_PORT=7777
NIP50_HOST=0.0.0.0
NIP50_MAX_LIMIT=100

# ─── Abuse Report API ───
ABUSE_API_PORT=8080
ABUSE_API_HOST=0.0.0.0
# Generate a strong random token for admin access:
#   openssl rand -hex 32
ABUSE_ADMIN_TOKEN=change-me-to-a-strong-random-token
REPORTS_DIR=./data/reports

# ─── Logging ───
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
NODE_ENV=production
